# ==============================================
# DemandAI — Environment Variables (TEMPLATE)
# Copy to .env and edit. NEVER commit the real .env file.
# All variables are OPTIONAL; the project runs with sensible defaults.
# ==============================================

# --- Backend (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated allowed browser origins for CORS.
# Leave UNSET for local dev (Vite proxies /api, so CORS is not needed).
# Set in production to your deployed frontend origin, e.g.:
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app
CORS_ALLOW_ORIGINS=

# --- Frontend (Vite) ---
# Base URL the dashboard uses to reach the API. Defaults to "/api"
# (proxied to the backend in dev). Set to your deployed backend URL in
# production, e.g. https://your-service.onrender.com
VITE_API_BASE_URL=/api
