# ==============================================
# DemandAI - Environment Variables (TEMPLATE)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ==============================================

# --- PostgreSQL ---
POSTGRES_USER=demandai_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=demandai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy connection URL (built from the values above)
DATABASE_URL=postgresql://demandai_user:change_me@localhost:5432/demandai

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# --- ML Configuration ---
MODEL_DIR=saved_models
DATASET_DIR=datasets
SAFETY_STOCK_FACTOR=0.15    # 15% of predicted demand added as safety stock

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
