# ==============================================
# DemandAI Backend — Environment Variables (TEMPLATE)
# Copy to backend/.env and edit. NEVER commit the real .env.
# All variables are OPTIONAL; the API runs with sensible defaults.
# ==============================================

# Host/port for uvicorn (informational; pass to uvicorn explicitly if used).
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed browser origins for CORS.
# Leave UNSET for local development (Vite proxies /api, so no CORS needed).
# Set this in production when the frontend is hosted on a different origin,
# e.g. your deployed dashboard URL:
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app
CORS_ALLOW_ORIGINS=
